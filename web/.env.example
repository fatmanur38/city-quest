# ---------------------------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------------------------
# 84532 = Base Sepolia testnet. 31337 = a local Anvil node.
# This project is testnet only. Never point it at a network holding real funds.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org

# ---------------------------------------------------------------------------------------------
# Contract addresses (printed by the deploy script, also written to contracts/deployments/)
# ---------------------------------------------------------------------------------------------
NEXT_PUBLIC_INSTITUTION_REGISTRY_ADDRESS=
NEXT_PUBLIC_CITY_PASSPORT_ADDRESS=
NEXT_PUBLIC_EXPERIENCE_PASS_ADDRESS=

# ---------------------------------------------------------------------------------------------
# Keys — server side only, never exposed to the browser
# ---------------------------------------------------------------------------------------------
# The ONLY account that needs a funded balance. It pays gas for every transaction in the system
# and acts as the municipality admin. It holds no authority of its own: every transaction it sends
# carries an institution's signature, which the contracts check instead of checking the sender.
RELAYER_PRIVATE_KEY=

# One key per institution. These sign but never transact, so these addresses need no ether at all.
# In production each institution runs its own signing service and the key lives in that
# institution's HSM — they are together here only because a single Next.js process is standing in
# for three organisations during the demo.
LIBRARY_SIGNER_PRIVATE_KEY=
SCIENCE_CENTER_SIGNER_PRIVATE_KEY=
MUNICIPALITY_SIGNER_PRIVATE_KEY=

# Signs session cookies. Any long random string; change it for anything public.
SESSION_SECRET=

# DEMO MOCK — institution staff and municipality sign-in codes. Replaced by real staff accounts
# in production (see src/server/session.ts).
OPERATOR_PIN=1234
ADMIN_PIN=cityquest

# ---------------------------------------------------------------------------------------------
# Database (optional)
# ---------------------------------------------------------------------------------------------
# Leave these blank to run against a local JSON file at .data/cityquest.json, which is what
# `npm run dev` does on a fresh clone. Set them to use Postgres.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google sign-in (optional) -------------------------------------------------------------
# Both public values come from Supabase > Project Settings > API. When either is missing the
# Google button is simply not offered, and the device account remains the only way in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A long random string. Every city account signed in with Google is derived from this, so
# changing it strands every account already created. Set it once and never rotate it.
ACCOUNT_DERIVATION_SECRET=
